  "paper": {
    "title": "Fake news detection: A survey of graph neural network methods",
    "authors": [
      "Huyen Trang Phan",
      "Ngoc Thanh Nguyên",
      "Dosam Hwang"
    ],
    "year": 2023,
    "date": "2023-03-23",
    "venue": "Applied Soft Computing",
    "doi": "10.1016/j.asoc.2023.110235",
    "arxiv_id": null,
    "pmid": "36999094",
    "openalex_id": "W4360602683",
